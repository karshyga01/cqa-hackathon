# Скопируйте в .env и при необходимости поменяйте значения.

# Порт сайта: http://localhost:3000
PORT=3000

# Адрес API организаторов без параметра group_id.
# Если не указан — берётся адрес DEV из задания.
# ORG_API_URL=https://...

# Папка для загруженных диалогов и оценок
DATA_DIR=data

# Другие сайты, которым разрешено обращаться к API (например, Dynamics 365), через запятую.
# Сам сайт CQA работает без этой настройки.
# ALLOWED_ORIGINS=https://yourorg.crm11.dynamics.com

# С каких доменов сервер может скачивать записи звонков (только https).
# По умолчанию — домены организаторов.
# AUDIO_ALLOWED_HOSTS=*.api.powerplatform.com,*.dynamics.com

# Название команды для results.json (поле team_name). Можно ввести и в окне «Выгрузить результаты».
# TEAM_NAME=CQA Team

# ---------- Оценка ИИ (OpenRouter) ----------
# Ключ: https://openrouter.ai/keys . Хранится только здесь, в браузер не попадает.
# OPENROUTER_API_KEY=sk-or-...

# Модель (закреплённая версия, чтобы оценки повторялись) и провайдер (без переключения на другие).
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_PROVIDER=together

# Глубина рассуждения модели: low | medium | high
# OPENROUTER_REASONING=medium

# Сколько диалогов оценивать одновременно (1–16)
# OPENROUTER_CONCURRENCY=8
